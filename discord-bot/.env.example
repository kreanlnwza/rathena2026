# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Discord Server (Guild) ID - for fast command sync
GUILD_ID=your_guild_id_here

# Channel ID สำหรับ Drop Notifications
DROP_CHANNEL_ID=channel_id_for_drops

# Role ID สำหรับ Admin Commands
ADMIN_ROLE_ID=admin_role_id_here

# Role ID ที่จะให้เมื่อ Verify สำเร็จ (ถ้าไม่ต้องการ ปล่อยว่าง)
VERIFIED_ROLE_ID=

# ----------- Game Database -----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ragnarok
DB_PASS=ragnarok

# Main database (login, char, storage, etc.)
DB_NAME=ragnarok

# Log database (picklog, atcommandlog, etc.)
DB_LOG_NAME=ragnarok_log

# Path to rAthena root directory
RATHENA_PATH=/home/user/rathena2026

# Poll interval (seconds) for drop notifications
DROP_POLL_INTERVAL=30
